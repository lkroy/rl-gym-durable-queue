#!/usr/bin/env python3
"""q - a durable, crash-safe job queue CLI (reference implementation).

Standard library only. All state lives under $QDATA_DIR (default ./.qdata).

Every command conceptually: lock, load (snapshot + WAL replay + torn-tail
truncation), sweep expired leases (jobs and idempotency mappings), execute,
append WAL ops in ONE fsync'd write (a batch is a single WAL record, so a
kill mid-batch leaves all or none of its jobs), rewrite the snapshot
atomically (tmp + fsync + rename), unlock.
"""

import argparse
import fcntl
import json
import os
import re
import secrets
import sys
import time

ID_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")
STATUSES = ("pending", "claimed", "done", "dead")


def die(msg, code):
    sys.stderr.write(str(msg) + "\n")
    sys.exit(code)


def data_dir():
    return os.environ.get("QDATA_DIR", "./.qdata")


def utcnow():
    return time.time()


# ------------------------------------------------------------- persistence ---

def _acquire_lock(dirpath):
    os.makedirs(dirpath, exist_ok=True)
    fh = open(os.path.join(dirpath, ".lock"), "a")
    fcntl.flock(fh.fileno(), fcntl.LOCK_EX)
    return fh


def _fsync_dir(dirpath):
    try:
        fd = os.open(dirpath, os.O_DIRECTORY)
    except OSError:
        return
    try:
        os.fsync(fd)
    except OSError:
        pass
    finally:
        os.close(fd)


def _well_formed_op(obj):
    if not isinstance(obj, dict):
        return False
    op = obj.get("op")
    if op == "upsert":
        return (isinstance(obj.get("job"), dict)
                and bool(obj["job"].get("id")))
    if op == "upsert_batch":
        jobs = obj.get("jobs")
        return (isinstance(jobs, list)
                and all(isinstance(j, dict) and j.get("id") for j in jobs))
    if op == "idem":
        return (isinstance(obj.get("key"), str)
                and isinstance(obj.get("job_id"), str))
    if op == "idem_del":
        return isinstance(obj.get("key"), str)
    return False


def _truncate_torn_tail(path):
    """Drop a trailing partial/corrupt WAL segment. Return True if truncated.

    A torn tail is any trailing bytes after the last newline (a writer that
    crashed mid-line) or a line that is not a well-formed op record.
    Everything from the first bad byte onward is discarded.
    """
    try:
        with open(path, "rb") as f:
            data = f.read()
    except FileNotFoundError:
        return False
    if not data:
        return False
    orig_len = len(data)
    if not data.endswith(b"\n"):
        idx = data.rfind(b"\n")
        data = data[: idx + 1] if idx >= 0 else b""
    good_end = len(data)
    off = 0
    for chunk in data.split(b"\n"):
        if not chunk:
            off += 1
            continue
        try:
            obj = json.loads(chunk.decode("utf-8"))
        except Exception:
            good_end = off
            break
        if not _well_formed_op(obj):
            good_end = off
            break
        off += len(chunk) + 1
    if good_end < orig_len:
        with open(path, "r+b") as f:
            f.truncate(good_end)
            f.flush()
            os.fsync(f.fileno())
        _fsync_dir(os.path.dirname(path) or ".")
        return True
    return False


def _load_snapshot(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            obj = json.load(f)
    except (FileNotFoundError, ValueError, OSError):
        return {}
    jobs = obj.get("jobs") if isinstance(obj, dict) else None
    if not isinstance(jobs, dict):
        return {}
    clean = {}
    for key, val in jobs.items():
        if isinstance(val, dict) and val.get("id") == key:
            clean[key] = val
    return clean


def _load_idem_snapshot(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            obj = json.load(f)
    except (FileNotFoundError, ValueError, OSError):
        return {}
    idem = obj.get("idem") if isinstance(obj, dict) else None
    if not isinstance(idem, dict):
        return {}
    clean = {}
    for key, val in idem.items():
        if (isinstance(key, str) and isinstance(val, dict)
                and isinstance(val.get("job_id"), str)):
            clean[key] = {"job_id": val["job_id"],
                          "lease_expires_at": val.get("lease_expires_at")}
    return clean


def _load_wal(path):
    _truncate_torn_tail(path)
    jobs = {}
    try:
        with open(path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                obj = json.loads(line)
                if obj.get("op") == "upsert":
                    job = obj["job"]
                    jobs[job["id"]] = job
                elif obj.get("op") == "upsert_batch":
                    for job in obj["jobs"]:
                        jobs[job["id"]] = job
                # idem ops are replayed by _load_wal_idem
    except FileNotFoundError:
        pass
    return jobs


def _load_wal_idem(path):
    _truncate_torn_tail(path)
    idem = {}
    try:
        with open(path, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                obj = json.loads(line)
                if obj.get("op") == "idem":
                    idem[obj["key"]] = {
                        "job_id": obj["job_id"],
                        "lease_expires_at": obj.get("lease_expires_at")}
                elif obj.get("op") == "idem_del":
                    idem.pop(obj["key"], None)
    except FileNotFoundError:
        pass
    return idem


def load_state(dirpath):
    jobs = _load_snapshot(os.path.join(dirpath, "snapshot.json"))
    jobs.update(_load_wal(os.path.join(dirpath, "wal.log")))
    return jobs


def load_idem(dirpath):
    idem = _load_idem_snapshot(os.path.join(dirpath, "snapshot.json"))
    idem.update(_load_wal_idem(os.path.join(dirpath, "wal.log")))
    return idem


def append_ops(dirpath, ops):
    ops = list(ops)
    if not ops:
        return
    path = os.path.join(dirpath, "wal.log")
    with open(path, "a", encoding="utf-8") as f:
        for op in ops:
            f.write(json.dumps(op, separators=(",", ":")) + "\n")
        f.flush()
        os.fsync(f.fileno())
    _fsync_dir(dirpath)


def write_snapshot(dirpath, jobs, idem):
    path = os.path.join(dirpath, "snapshot.json")
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump({"jobs": jobs, "idem": idem}, f, separators=(",", ":"))
        f.flush()
        os.fsync(f.fileno())
    os.rename(tmp, path)
    _fsync_dir(dirpath)


def truncate_wal(dirpath):
    path = os.path.join(dirpath, "wal.log")
    with open(path, "w", encoding="utf-8") as f:
        f.flush()
        os.fsync(f.fileno())
    _fsync_dir(dirpath)


# ------------------------------------------------------------------ logic ---

def sweep_expired(jobs, t):
    """Return claimed jobs whose lease expired back to pending. Ids changed."""
    changed = []
    for job in jobs.values():
        if (job["status"] == "claimed"
                and job.get("lease_expires_at") is not None
                and job["lease_expires_at"] <= t):
            job["status"] = "pending"
            job["claimed_at"] = None
            job["lease_expires_at"] = None
            changed.append(job["id"])
    return changed


def sweep_idem(idem, t):
    """Discard idempotency mappings whose lease has expired. Keys discarded."""
    discarded = []
    for key in list(idem.keys()):
        entry = idem[key]
        if (entry.get("lease_expires_at") is not None
                and entry["lease_expires_at"] <= t):
            del idem[key]
            discarded.append(key)
    return discarded


def _discard_idem_for_job(ctx, jid):
    idem = ctx["idem"]
    for key in [k for k, e in idem.items() if e["job_id"] == jid]:
        del idem[key]
        ctx["idem_ops"].append((key, None))


def _new_id(jobs):
    while True:
        jid = secrets.token_hex(8)
        if jid not in jobs:
            return jid


def _find_dedupe(jobs, key):
    for job in jobs.values():
        if job.get("dedupe_key") == key and job["status"] in ("pending", "claimed"):
            return job
    return None


def _get_job_or_die(jobs, jid):
    job = jobs.get(jid)
    if job is None:
        die("job not found: %s" % jid, 4)
    return job


def summarize(job):
    return {"id": job["id"], "status": job["status"],
            "priority": job["priority"], "attempts": job["attempts"],
            "created_at": job["created_at"], "run_at": job["run_at"]}


def _check_id_format(jid):
    if not ID_RE.match(jid):
        die("invalid id: must match ^[A-Za-z0-9_-]{1,64}$", 2)


def cmd_enqueue(args, jobs, t, dirty, ctx):
    try:
        payload = json.loads(args.payload)
    except ValueError:
        die("invalid payload: not valid JSON", 2)
    if args.id is not None:
        _check_id_format(args.id)
        if args.id in jobs:
            die("duplicate id: %s" % args.id, 2)
        jid = args.id
    else:
        jid = _new_id(jobs)
    if args.delay < 0:
        die("delay must be >= 0", 2)
    if args.max_attempts < 1:
        die("max_attempts must be >= 1", 2)
    if args.dedupe_key is not None:
        hit = _find_dedupe(jobs, args.dedupe_key)
        if hit is not None:
            sys.stdout.write(hit["id"] + "\n")
            return 0
    job = {
        "id": jid,
        "payload": payload,
        "priority": args.priority,
        "max_attempts": args.max_attempts,
        "attempts": 0,
        "status": "pending",
        "created_at": t,
        "run_at": t + args.delay,
        "dedupe_key": args.dedupe_key,
        "claimed_at": None,
        "lease_expires_at": None,
        "last_error": None,
        "result": None,
    }
    jobs[jid] = job
    dirty.add(jid)
    sys.stdout.write(jid + "\n")
    return 0


def _validate_batch_element(el, i, jobs, seen_ids):
    if not isinstance(el, dict):
        die("invalid jobs: element %d is not an object" % i, 2)
    if "payload" not in el:
        die("invalid jobs: element %d is missing payload" % i, 2)
    priority = el.get("priority", 0)
    if isinstance(priority, bool) or not isinstance(priority, int):
        die("invalid jobs: element %d has bad priority" % i, 2)
    delay = el.get("delay", 0)
    if isinstance(delay, bool) or not isinstance(delay, (int, float)):
        die("invalid jobs: element %d has bad delay" % i, 2)
    if delay < 0:
        die("invalid jobs: element %d has negative delay" % i, 2)
    max_attempts = el.get("max_attempts", 3)
    if (isinstance(max_attempts, bool)
            or not isinstance(max_attempts, int) or max_attempts < 1):
        die("invalid jobs: element %d has bad max_attempts" % i, 2)
    jid = el.get("id")
    if jid is not None:
        if not isinstance(jid, str) or not ID_RE.match(jid):
            die("invalid jobs: element %d has bad id" % i, 2)
        if jid in jobs or jid in seen_ids:
            die("invalid jobs: element %d has duplicate id" % i, 2)
        seen_ids.add(jid)
    dedupe_key = el.get("dedupe_key")
    if dedupe_key is not None and not isinstance(dedupe_key, str):
        die("invalid jobs: element %d has bad dedupe_key" % i, 2)
    return {"payload": el["payload"], "priority": priority, "delay": delay,
            "max_attempts": max_attempts, "id": jid,
            "dedupe_key": dedupe_key}


def cmd_enqueue_batch(args, jobs, t, dirty, ctx):
    try:
        items = json.loads(args.jobs)
    except ValueError:
        die("invalid jobs: not a JSON array", 2)
    if not isinstance(items, list):
        die("invalid jobs: not a JSON array", 2)
    # Pass 1: validate EVERY element before creating anything.
    seen_ids = set()
    specs = [_validate_batch_element(el, i, jobs, seen_ids)
             for i, el in enumerate(items)]
    # Pass 2: create in order; dedupe resolves per element (an earlier
    # element of this batch counts as an existing job).
    ids = []
    new_jobs = []
    for spec in specs:
        if spec["dedupe_key"] is not None:
            hit = _find_dedupe(jobs, spec["dedupe_key"])
            if hit is not None:
                ids.append(hit["id"])
                continue
        jid = spec["id"] if spec["id"] is not None else _new_id(jobs)
        job = {
            "id": jid,
            "payload": spec["payload"],
            "priority": spec["priority"],
            "max_attempts": spec["max_attempts"],
            "attempts": 0,
            "status": "pending",
            "created_at": t,
            "run_at": t + spec["delay"],
            "dedupe_key": spec["dedupe_key"],
            "claimed_at": None,
            "lease_expires_at": None,
            "last_error": None,
            "result": None,
        }
        jobs[jid] = job
        new_jobs.append(job)
        ids.append(jid)
    # The whole batch is persisted as ONE WAL record: a kill mid-batch can
    # only leave the complete batch or a torn tail (discarded) behind.
    if new_jobs:
        ctx["batch"] = new_jobs
    sys.stdout.write(json.dumps(ids) + "\n")
    return 0


def cmd_list(args, jobs, t, dirty, ctx):
    rows = [summarize(j) for j in jobs.values()]
    if args.status is not None:
        rows = [r for r in rows if r["status"] == args.status]
    rows.sort(key=lambda r: (r["created_at"], r["id"]))
    sys.stdout.write(json.dumps(rows) + "\n")
    return 0


def cmd_show(args, jobs, t, dirty, ctx):
    job = _get_job_or_die(jobs, args.id)
    sys.stdout.write(json.dumps(job) + "\n")
    return 0


def cmd_claim(args, jobs, t, dirty, ctx):
    if args.lease <= 0:
        die("lease must be > 0", 2)
    key = args.idempotency_key
    if key is not None:
        _check_id_format(key)
    idem = ctx["idem"]
    if key is not None:
        entry = idem.get(key)
        if entry is not None:
            job = jobs.get(entry["job_id"])
            if (job is not None and job["status"] == "claimed"
                    and job.get("lease_expires_at") is not None
                    and job["lease_expires_at"] > t):
                sys.stdout.write(json.dumps(job) + "\n")
                return 0
        # stale or missing mapping: fall through to a fresh claim
    cands = [j for j in jobs.values()
             if j["status"] == "pending" and j["run_at"] <= t]
    cands.sort(key=lambda j: (-j["priority"], j["created_at"], j["id"]))
    if not cands:
        die("no jobs available", 1)
    job = cands[0]
    job["status"] = "claimed"
    job["claimed_at"] = t
    job["lease_expires_at"] = t + args.lease
    dirty.add(job["id"])
    if key is not None:
        entry = {"job_id": job["id"],
                 "lease_expires_at": t + args.lease}
        idem[key] = entry
        ctx["idem_ops"].append((key, entry))
    sys.stdout.write(json.dumps(job) + "\n")
    return 0


def cmd_complete(args, jobs, t, dirty, ctx):
    job = _get_job_or_die(jobs, args.id)
    pass  # BUG: claimed-state check skipped
    result = None
    if args.result is not None:
        try:
            result = json.loads(args.result)
        except ValueError:
            die("invalid result: not valid JSON", 2)
    job["status"] = "done"
    job["result"] = result
    dirty.add(job["id"])
    _discard_idem_for_job(ctx, job["id"])
    sys.stdout.write(job["id"] + "\n")
    return 0


def cmd_fail(args, jobs, t, dirty, ctx):
    job = _get_job_or_die(jobs, args.id)
    if job["status"] != "claimed":
        die("job not claimed", 3)  # REQ-CLAIMED-FAIL
    job["attempts"] += 1
    if job["attempts"] >= job["max_attempts"]:
        job["status"] = "dead"
    else:
        job["status"] = "pending"
        job["run_at"] = t + 10 * 2 ** (job["attempts"] - 1)
    job["claimed_at"] = None
    job["lease_expires_at"] = None
    job["last_error"] = args.error
    dirty.add(job["id"])
    if job["status"] == "dead":
        _discard_idem_for_job(ctx, job["id"])
    sys.stdout.write(job["id"] + "\n")
    return 0


def cmd_stats(args, jobs, t, dirty, ctx):
    counts = {"pending": 0, "claimed": 0, "done": 0, "dead": 0}
    for job in jobs.values():
        if job["status"] in counts:
            counts[job["status"]] += 1
    counts["total"] = sum(counts.values())
    sys.stdout.write(json.dumps(counts) + "\n")
    return 0


def cmd_compact(args, jobs, t, dirty, ctx):
    ctx["compact"] = True
    sys.stdout.write("ok\n")
    return 0


COMMANDS = {
    "enqueue": cmd_enqueue,
    "enqueue-batch": cmd_enqueue_batch,
    "list": cmd_list,
    "show": cmd_show,
    "claim": cmd_claim,
    "complete": cmd_complete,
    "fail": cmd_fail,
    "stats": cmd_stats,
    "compact": cmd_compact,
}


def parse_args(argv):
    p = argparse.ArgumentParser(prog="q", allow_abbrev=False)
    sub = p.add_subparsers(dest="cmd")
    e = sub.add_parser("enqueue", allow_abbrev=False)
    e.add_argument("--payload", required=True)
    e.add_argument("--priority", type=int, default=0)
    e.add_argument("--delay", type=float, default=0.0)
    e.add_argument("--id", default=None)
    e.add_argument("--dedupe-key", default=None)
    e.add_argument("--max-attempts", type=int, default=3)
    b = sub.add_parser("enqueue-batch", allow_abbrev=False)
    b.add_argument("--jobs", required=True)
    li = sub.add_parser("list", allow_abbrev=False)
    li.add_argument("--status", choices=list(STATUSES), default=None)
    sh = sub.add_parser("show", allow_abbrev=False)
    sh.add_argument("id")
    cl = sub.add_parser("claim", allow_abbrev=False)
    cl.add_argument("--lease", type=float, default=60.0)
    cl.add_argument("--idempotency-key", default=None)
    co = sub.add_parser("complete", allow_abbrev=False)
    co.add_argument("id")
    co.add_argument("--result", default=None)
    fa = sub.add_parser("fail", allow_abbrev=False)
    fa.add_argument("id")
    fa.add_argument("--error", default=None)
    sub.add_parser("stats", allow_abbrev=False)
    sub.add_parser("compact", allow_abbrev=False)
    args = p.parse_args(argv)
    if args.cmd is None:
        p.error("unknown command")
    return args


def main(argv):
    args = parse_args(argv)
    dirpath = data_dir()
    lockfh = _acquire_lock(dirpath)
    try:
        t = utcnow()
        jobs = load_state(dirpath)
        idem = load_idem(dirpath)
        dirty = set(sweep_expired(jobs, t))
        ctx = {"idem": idem, "idem_ops": []}
        for key in sweep_idem(idem, t):
            ctx["idem_ops"].append((key, None))
        code = COMMANDS[args.cmd](args, jobs, t, dirty, ctx)
        if ctx.get("compact"):
            write_snapshot(dirpath, jobs, idem)
            truncate_wal(dirpath)
        elif dirty or ctx["idem_ops"] or ctx.get("batch"):
            ops = []
            if ctx.get("batch"):
                ops.append({"op": "upsert_batch", "jobs": ctx["batch"]})
            for jid in sorted(dirty):
                if jid in jobs:
                    ops.append({"op": "upsert", "job": jobs[jid]})
            for key, entry in ctx["idem_ops"]:
                if entry is None:
                    ops.append({"op": "idem_del", "key": key})
                else:
                    ops.append({"op": "idem", "key": key,
                                "job_id": entry["job_id"],
                                "lease_expires_at": entry["lease_expires_at"]})
            append_ops(dirpath, ops)
            write_snapshot(dirpath, jobs, idem)
        return code
    finally:
        lockfh.close()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

