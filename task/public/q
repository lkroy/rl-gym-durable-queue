import argparse
import sys

STATUSES = ("pending", "claimed", "done", "dead")


def parse_args(argv):
    p = argparse.ArgumentParser(prog="q", allow_abbrev=False)
    sub = p.add_subparsers(dest="cmd")
    e = sub.add_parser("enqueue", allow_abbrev=False)
    e.add_argument("--payload", required=True)
    e.add_argument("--priority", type=int, default=0)
    e.add_argument("--delay", type=float, default=0.0)
    e.add_argument("--id", default=None)
    e.add_argument("--dedupe-key", default=None)
    e.add_argument("--max-attempts", type=int, default=3)
    e.add_argument("--ttl", type=float, default=None)
    e.add_argument("--depends-on", dest="depends_on", default=None)
    e.add_argument("--tag", default=None)
    b = sub.add_parser("enqueue-batch", allow_abbrev=False)
    b.add_argument("--jobs", required=True)
    li = sub.add_parser("list", allow_abbrev=False)
    li.add_argument("--status", choices=list(STATUSES), default=None)
    sh = sub.add_parser("show", allow_abbrev=False)
    sh.add_argument("id")
    cl = sub.add_parser("claim", allow_abbrev=False)
    cl.add_argument("--lease", type=float, default=60.0)
    cl.add_argument("--idempotency-key", default=None)
    cl.add_argument("--count", type=int, default=None)
    cl.add_argument("--tag", default=None)
    co = sub.add_parser("complete", allow_abbrev=False)
    co.add_argument("id")
    co.add_argument("--fence", type=int, default=None)
    co.add_argument("--result", default=None)
    fa = sub.add_parser("fail", allow_abbrev=False)
    fa.add_argument("id")
    fa.add_argument("--fence", type=int, default=None)
    fa.add_argument("--error", default=None)
    sub.add_parser("stats", allow_abbrev=False)
    s = sub.add_parser("schedule", allow_abbrev=False)
    s.add_argument("--payload", required=True)
    s.add_argument("--cron", required=True)
    s.add_argument("--id", default=None)
    s.add_argument("--priority", type=int, default=0)
    s.add_argument("--max-attempts", type=int, default=3)
    s.add_argument("--end-at", type=float, default=None)
    s.add_argument("--tz", default="UTC")
    sub.add_parser("schedules", allow_abbrev=False)
    u = sub.add_parser("unschedule", allow_abbrev=False)
    u.add_argument("id")
    x = sub.add_parser("extend-lease", allow_abbrev=False)
    x.add_argument("id")
    x.add_argument("--fence", type=int, default=None)
    x.add_argument("--lease", type=float, required=True)
    sub.add_parser("compact", allow_abbrev=False)
    sub.add_parser("pause", allow_abbrev=False)
    sub.add_parser("drain", allow_abbrev=False)
    sub.add_parser("resume", allow_abbrev=False)
    ca = sub.add_parser("cancel", allow_abbrev=False)
    ca.add_argument("id")
    ca.add_argument("--cascade", action="store_true", default=False)
    args = p.parse_args(argv)
    if args.cmd is None:
        p.error("unknown command")
    return args


def main(argv):
    parse_args(argv)  # validates the CLI surface only
    sys.stderr.write("not implemented\n")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

